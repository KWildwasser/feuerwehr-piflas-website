# Feuerwehr Piflas – Übergangsseite (Apache)

DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Immer HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Ohne www -> mit www
  RewriteCond %{HTTP_HOST} ^feuerwehr-piflas\.de$ [NC]
  RewriteRule ^ https://www.feuerwehr-piflas.de%{REQUEST_URI} [R=301,L]

  # Alte Joomla-Adressen (index.php/...) auf die Startseite leiten
  RewriteRule ^index\.php(/.*)?$ / [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
